/*
 * Lily58 coding layout. Key legends assume a US keyboard layout on the host.
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Familiar QWERTY, dedicated modifiers, and frequently used punctuation.
            //                                                   ,------- inner keys -------.
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                         &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T                          &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G                          &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LBKT  &kp RBKT     &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                    &kp LGUI &kp LALT &mo 1 &kp SPACE  &kp RET &mo 2 &kp BSPC &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols_layer {
            // Hold the left SYM thumb. Bracket pairs and operators are on home row.
            // Bluetooth profiles are on the top left; clear is deliberately in a corner.
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans &trans &trans &trans &trans &trans
&kp TILDE  &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT                           &kp CARET &kp AMPS &kp LS(N8) &kp LPAR &kp RPAR &kp PLUS
&trans     &kp GRAVE &kp LBKT &kp RBKT &kp LBRC &kp RBRC                         &kp LS(SEMI) &kp BSLH &kp PIPE &kp EQUAL &kp LT &kp GT
&trans     &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT &trans &trans             &kp UNDERSCORE &kp MINUS &kp COMMA &kp DOT &kp FSLH &trans
                         &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navigation_layer {
            // Hold the right NAV thumb. Arrows under H/J/K/L; modifiers stay accessible.
            bindings = <
&kp F1    &kp F2 &kp F3 &kp F4 &kp F5 &kp F6                       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans    &trans &trans &trans &trans &trans                         &kp PG_UP &kp HOME &kp UP &kp END &kp INS &trans
&trans    &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans               &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_DN &trans
&trans    &trans &trans &trans &trans &trans &trans &trans           &kp HOME &kp END &kp PG_UP &kp PG_DN &kp DEL &trans
                       &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
